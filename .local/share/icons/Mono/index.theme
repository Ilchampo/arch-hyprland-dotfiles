[Icon Theme]
Name=Mono
Comment=Mono folders and places, with Adwaita fallback for application and file-type icons
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/mimetypes

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes
