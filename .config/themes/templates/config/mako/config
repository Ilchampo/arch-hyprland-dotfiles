font=JetBrainsMono Nerd Font 13
background-color=#{{bg}}D6
text-color=#{{text}}
border-size=2
border-color=#{{fill}}EE
border-radius=10
padding=12
margin=8
outer-margin=56,20,20,20
width=360
height=140
max-icon-size=48
icon-border-radius=8
progress-color=over #{{fill}}CC
default-timeout=5000
max-visible=5
anchor=top-right
layer=overlay
icons=1
markup=1
actions=1
format=<b>%s</b>\n%b

[urgency=low]
border-color=#{{border}}AA
text-color=#{{muted}}
default-timeout=4000

[urgency=normal]
border-color=#{{fill}}EE
default-timeout=5000

[urgency=critical]
border-color=#{{danger}}FF
text-color=#{{text}}
default-timeout=0
