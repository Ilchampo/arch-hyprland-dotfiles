{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "group/pill-left"
    ],
    "modules-center": [
        "group/pill-center"
    ],
    "modules-right": [
        "group/pill-right"
    ],

    "group/pill-left": {
        "orientation": "horizontal",
        "modules": [
            "ext/workspaces"
        ]
    },

    "group/pill-center": {
        "orientation": "horizontal",
        "modules": [
            "clock",
            "network",
            "group/media"
        ]
    },

    "group/pill-right": {
        "orientation": "horizontal",
        "modules": [
            "group/volume",
            "cpu",
            "memory",
            "custom/lock",
            "custom/reboot",
            "custom/shutdown"
        ]
    },

    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio/slider",
            "pulseaudio"
        ]
    },

    "ext/workspaces": {
        "all-outputs": true,
        "sort-by-id": true,
        "ignore-hidden": false,
        "format": "{id}  {icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "<span foreground='#{{accent}}'>●</span>",
            "urgent": "<span foreground='#{{danger}}'>●</span>",
            "default": "<span foreground='#{{border}}'>●</span>"
        }
    },

    "clock": {
        "interval": 1,
        "format": "{:%d/%m/%Y  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-prev",
            "custom/media-play",
            "custom/media-next",
            "custom/media-title"
        ]
    },

    "custom/media-prev": {
        "format": "󰒮",
        "tooltip-format": "Previous",
        "on-click": "playerctl previous"
    },

    "custom/media-play": {
        "exec": "$HOME/.config/waybar/scripts/media-play.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{icon}",
        "format-icons": {
            "Playing": "󰏤",
            "Paused": "󰐊",
            "Stopped": "󰐊"
        },
        "on-click": "playerctl play-pause"
    },

    "custom/media-next": {
        "format": "󰒭",
        "tooltip-format": "Next",
        "on-click": "playerctl next"
    },

    "custom/media-title": {
        "exec": "$HOME/.config/waybar/scripts/media-ticker.py",
        "return-type": "json",
        "escape": true,
        "restart-interval": 2,
        "tooltip": true
    },

    "network": {
        "interval": 5,
        "format-ethernet": "●  Connected",
        "format-wifi": "●  Connected",
        "format-linked": "●  Connected",
        "format-disconnected": "●  Disconnected",
        "format-disabled": "●  Disconnected",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "tooltip-format": "{desc}: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠  {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip-format": "Lock session",
        "on-click": "hyprlock"
    },

    "custom/reboot": {
        "format": "󰜉",
        "tooltip-format": "Restart system",
        "on-click": "systemctl reboot"
    },

    "custom/shutdown": {
        "format": "󰐥",
        "tooltip-format": "Shut down system",
        "on-click": "systemctl poweroff"
    }
}
