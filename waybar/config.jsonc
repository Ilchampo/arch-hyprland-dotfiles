{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "group/pill-left"
    ],
    "modules-center": [
        "group/pill-center"
    ],
    "modules-right": [
        "group/pill-right"
    ],

    "group/pill-left": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/workspaces"
        ]
    },

    "group/pill-center": {
        "orientation": "horizontal",
        "modules": [
            "clock",
            "network"
        ]
    },

    "group/pill-right": {
        "orientation": "horizontal",
        "modules": [
            "group/volume",
            "cpu",
            "memory",
            "custom/lock",
            "custom/reboot",
            "custom/shutdown"
        ]
    },

    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio/slider",
            "pulseaudio"
        ]
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "sort-by-number": true,
        "format": "{id}  {icon}",
        "format-icons": {
            "active": "<span foreground='#D4A05A'>●</span>",
            "urgent": "<span foreground='#D97070'>●</span>",
            "default": "<span foreground='#6A7466'>●</span>"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "interval": 1,
        "format": "{:%d/%m/%Y  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "network": {
        "interval": 5,
        "format-ethernet": "●",
        "format-wifi": "●",
        "format-linked": "●",
        "format-disconnected": "●",
        "format-disabled": "●",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "tooltip-format": "{desc}: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠  {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip-format": "Lock session",
        "on-click": "hyprlock"
    },

    "custom/reboot": {
        "format": "󰜉",
        "tooltip-format": "Restart system",
        "on-click": "systemctl reboot"
    },

    "custom/shutdown": {
        "format": "󰐥",
        "tooltip-format": "Shut down system",
        "on-click": "systemctl poweroff"
    }
}
